// Prisma Schema for FakturierungPro
// Generated by SQL Editor - 22.8.2026

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Kunden {
  Id Int @id @default(autoincrement())
  KundenNr String
  Firmenname String
  Ansprechpartner String
  Email String
  Telefon String
  Strasse String
  plz String
  Ort String
  UStIdNr String
  ZahlungszielTage Int @default(14)
  Status String @default("Aktiv")
  angebotes Angebote[]
  auftraeges Auftraege[]
  rechnungens Rechnungen[]
  mahnungens Mahnungen[]
  gutschriftens Gutschriften[]
  @@index([KundenNr])
  @@index([Firmenname])
}

model Artikel {
  Id Int @id @default(autoincrement())
  ArtikelNr String
  Bezeichnung String
  Kategorie String @default("Dienstleistung")
  Einzelpreis Float
  SteuerSatz Int @default(19)
  Einheit String @default("Std")
  Lagerbestand Int @default(100)
  angebotspositionens Angebotspositionen[]
  auftragspositionens Auftragspositionen[]
  rechnungspositionens Rechnungspositionen[]
  gutschriftpositionens Gutschriftpositionen[]
  @@index([ArtikelNr])
  @@index([Bezeichnung])
}

model Angebote {
  Id Int @id @default(autoincrement())
  AngebotsNr String
  KundenId Int
  Datum DateTime
  GueltigBis DateTime
  Status String @default("Versendet")
  NettoBetrag Float
  BruttoBetrag Float
  Bemerkung String
  kunden Kunden @relation(fields: [KundenId], references: [Id])
  angebotspositionens Angebotspositionen[]
  auftraeges Auftraege[]
  @@index([KundenId])
}

model Angebotspositionen {
  Id Int @id @default(autoincrement())
  AngebotsId Int
  ArtikelId Int
  Menge Float @default(1)
  Einzelpreis Float
  RabattProzent Float @default(0)
  GesamtNetto Float
  angebote Angebote @relation(fields: [AngebotsId], references: [Id], onDelete: Cascade)
  artikel Artikel @relation(fields: [ArtikelId], references: [Id])
  @@index([AngebotsId])
  @@index([ArtikelId])
}

model Auftraege {
  Id Int @id @default(autoincrement())
  AuftragsNr String
  AngebotsId Int
  KundenId Int
  AuftragsDatum DateTime
  LieferDatum DateTime
  Status String @default("In Bearbeitung")
  NettoBetrag Float
  BruttoBetrag Float
  kunden Kunden @relation(fields: [KundenId], references: [Id])
  angebote Angebote @relation(fields: [AngebotsId], references: [Id])
  auftragspositionens Auftragspositionen[]
  rechnungens Rechnungen[]
  @@index([AngebotsId])
  @@index([KundenId])
}

model Auftragspositionen {
  Id Int @id @default(autoincrement())
  AuftragsId Int
  ArtikelId Int
  Menge Float @default(1)
  Einzelpreis Float
  GesamtNetto Float
  auftraege Auftraege @relation(fields: [AuftragsId], references: [Id], onDelete: Cascade)
  artikel Artikel @relation(fields: [ArtikelId], references: [Id])
  @@index([AuftragsId])
  @@index([ArtikelId])
}

model Rechnungen {
  Id Int @id @default(autoincrement())
  RechnungsNr String
  AuftragsId Int
  KundenId Int
  RechnungsDatum DateTime
  FaelligDatum DateTime
  ZahlungsStatus String @default("Offen")
  NettoBetrag Float
  MwStBetrag Float
  BruttoBetrag Float
  OffenerBetrag Float
  SkontoProzent Float @default(2)
  kunden Kunden @relation(fields: [KundenId], references: [Id])
  auftraege Auftraege @relation(fields: [AuftragsId], references: [Id])
  rechnungspositionens Rechnungspositionen[]
  mahnungens Mahnungen[]
  gutschriftens Gutschriften[]
  @@index([RechnungsNr])
  @@index([AuftragsId])
  @@index([KundenId])
}

model Rechnungspositionen {
  Id Int @id @default(autoincrement())
  RechnungsId Int
  ArtikelId Int
  PositionNr Int @default(1)
  Menge Float @default(1)
  Einzelpreis Float
  SteuerSatz Int @default(19)
  GesamtNetto Float
  rechnungen Rechnungen @relation(fields: [RechnungsId], references: [Id], onDelete: Cascade)
  artikel Artikel @relation(fields: [ArtikelId], references: [Id])
  @@index([RechnungsId])
  @@index([ArtikelId])
}

model Mahnungen {
  Id Int @id @default(autoincrement())
  MahnungsNr String
  RechnungsId Int
  KundenId Int
  MahnDatum DateTime
  Mahnstufe String @default("Mahnstufe 1 (Zahlungserinnerung)")
  Mahngebuehr Float @default(5.00)
  Verzugszinsen Float @default(0.00)
  FaelligBis DateTime
  Status String @default("Offen")
  kunden Kunden @relation(fields: [KundenId], references: [Id])
  rechnungen Rechnungen @relation(fields: [RechnungsId], references: [Id], onDelete: Cascade)
  @@index([RechnungsId])
  @@index([KundenId])
}

model Gutschriften {
  Id Int @id @default(autoincrement())
  GutschriftNr String
  RechnungsId Int
  KundenId Int
  Datum DateTime
  Status String @default("Erstellt")
  NettoBetrag Float
  MwStBetrag Float
  BruttoBetrag Float
  Grund String
  kunden Kunden @relation(fields: [KundenId], references: [Id])
  rechnungen Rechnungen @relation(fields: [RechnungsId], references: [Id])
  gutschriftpositionens Gutschriftpositionen[]
  @@index([RechnungsId])
  @@index([KundenId])
}

model Gutschriftpositionen {
  Id Int @id @default(autoincrement())
  GutschriftId Int
  ArtikelId Int
  Menge Float @default(1)
  Einzelpreis Float
  GesamtNetto Float
  gutschriften Gutschriften @relation(fields: [GutschriftId], references: [Id], onDelete: Cascade)
  artikel Artikel @relation(fields: [ArtikelId], references: [Id])
  @@index([GutschriftId])
  @@index([ArtikelId])
}

